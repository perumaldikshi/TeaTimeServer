{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/start",
      "schedule": "25 11 * * *"
    },
    {
      "path": "/api/cron/end",
      "schedule": "40 11 * * *"
    }
  ]
}
